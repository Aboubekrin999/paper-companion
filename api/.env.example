# CORS allowlist — comma-separated. Add the Vercel deployment URL once it's live.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase — service-role key has admin privileges, NEVER expose to the browser.
# Get these from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude — used for chat responses with retrieved context.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
